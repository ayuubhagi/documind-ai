# Copy to .env and fill in real values. Never commit .env.

# AI provider: demo | groq | anthropic
#   demo      - default; canned responses, zero API calls, impossible to be charged
#   groq      - free tier, no payment method required: https://console.groq.com
#   anthropic - paid per token: https://platform.claude.com
LLM_PROVIDER=demo
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Required in production - generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Postgres password used by docker-compose
POSTGRES_PASSWORD=postgres

# Production only (docker-compose.prod.yml) - your domain, with DNS pointing at the server
DOMAIN=docmaid.example.com

# Billing (Stripe) - leave empty to run without billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:5173
