# Copy to .env and fill in real values. Never commit .env.

# Required — get one at https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...

# Required in production — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Postgres password used by docker-compose
POSTGRES_PASSWORD=postgres

# Production only (docker-compose.prod.yml) — your domain, with DNS pointing at the server
DOMAIN=documind.example.com
